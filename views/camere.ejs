<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <%- include('partials/img', { name: 'terrazza-vista-mare', alt: lang === 'it' ? 'Vista mare dalla terrazza' : 'Sea view from the terrace', sizes: '100vw', eager: true, cls: 'hero-img' }) %>
    <div class="hero-overlay"></div>
    <div class="wrap"><h1><%= page.h1 %></h1></div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <p class="lead"><%= page.lead %></p>
      <p><%= page.body %></p>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap">
      <h2><%= page.typesTitle %></h2>
      <ul class="rooms">
        <% page.types.forEach(function(r, i){ %>
        <li class="room">
          <span class="room-guests" aria-hidden="true"><% for (var k=0;k<=i && k<5;k++){ %>●<% } %></span>
          <h3><%= r.name %></h3>
          <p class="room-meta"><%= r.guests %></p>
          <p><%= r.text %></p>
          <a class="arrow" href="<%= routes.contatti[lang] %>"><%= t.ui.book %></a>
        </li>
        <% }) %>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2><%= page.amenitiesTitle %></h2>
        <ul class="checklist cols-2">
          <% page.amenities.forEach(function(s){ %><li><%= s %></li><% }) %>
        </ul>
      </div>
      <div class="infobox">
        <h2><%= page.infoTitle %></h2>
        <ul>
          <% page.info.forEach(function(s){ %><li><%= s %></li><% }) %>
        </ul>
        <a class="btn" href="<%= routes.contatti[lang] %>"><%= t.ui.book %></a>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
