<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a class="brand" href="<%= routes.home[lang] %>" aria-label="Nuovo Hotel Faro – Home">
      <img class="brand-logo" src="/img/logo-hotel-faro.webp" width="77" height="40" alt="Nuovo Hotel Faro">
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav"><span class="sr"><%= t.ui.menu %></span><span class="burger" aria-hidden="true"></span></button>
    <nav id="site-nav" class="site-nav" aria-label="<%= t.ui.menu %>">
      <ul>
        <% t.nav.forEach(function(n){ %><li><a href="<%= n.path %>"<% if (n.key === key) { %> aria-current="page"<% } %>><%= n.label %></a></li><% }) %>
      </ul>
      <a class="lang" href="<%= altPath %>" hreflang="<%= lang === 'it' ? 'en' : 'it' %>" lang="<%= lang === 'it' ? 'en' : 'it' %>" title="<%= t.ui.langSwitch %>"><%= t.ui.langSwitchShort %></a>
      <a class="btn btn-sm" href="<%= routes.contatti[lang] %>"><%= t.ui.book %></a>
    </nav>
  </div>
</header>
