<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <section class="section page-top">
    <div class="wrap narrow">
      <h1><%= page.h1 %></h1>
      <p class="lead"><%= page.lead %></p>
    </div>
  </section>

  <section class="section pt0">
    <div class="wrap contact-grid">
      <div class="contact-box">
        <h2><%= page.emailTitle %></h2>
        <p><%= page.emailText %></p>
        <p class="contact-big"><a href="mailto:<%= HOTEL.email %>"><%= HOTEL.email %></a></p>
        <a class="btn btn-lg" href="mailto:<%= HOTEL.email %>?subject=<%= encodeURIComponent(page.mailSubject) %>&body=<%= encodeURIComponent(page.mailBody) %>"><%= page.emailBtn %></a>
      </div>
      <div class="contact-box">
        <h2><%= page.phoneTitle %></h2>
        <p><%= t.ui.phone %></p>
        <p class="contact-big"><a href="tel:<%= HOTEL.phoneHref %>"><%= HOTEL.phone %></a></p>
        <a class="btn btn-lg btn-ghost" href="tel:<%= HOTEL.phoneHref %>"><%= page.phoneBtn %></a>
      </div>
      <aside class="contact-card">
        <h2>Nuovo Hotel Faro</h2>
        <p><strong><%= t.ui.address %></strong><br><%= HOTEL.street %><br><%= HOTEL.zip %> <%= HOTEL.city %> (<%= HOTEL.province %>)</p>
        <p><a href="<%= HOTEL.facebook %>" target="_blank" rel="noopener"><%= t.ui.followUs %></a></p>
        <p><a class="arrow" href="<%= routes['dove-siamo'][lang] %>"><%= t.nav[4].label %></a></p>
      </aside>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
