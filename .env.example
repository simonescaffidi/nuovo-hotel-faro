# Porta (Railway la imposta da sé)
PORT=3000
# URL pubblico canonico, senza slash finale (usato per canonical, sitemap, og:url)
PUBLIC_URL=https://www.nuovohotelfaro.com
# Fuso orario
TZ=Europe/Rome

# Email via API Brevo (mittente verificato su Brevo)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Nuovo Hotel Faro
# Destinatario delle richieste del modulo contatti (default info@nuovohotelfaro.com)
CONTACT_EMAIL=info@nuovohotelfaro.com
# Destinatario alert errori (default info@simonescaffidi.it)
ALERT_EMAIL=info@simonescaffidi.it
# Token per POST /admin/alert-test (header x-admin-token); vuoto = endpoint disattivo
ADMIN_TOKEN=

# Google Analytics 4 (G-XXXXXXX) e verifica Search Console (contenuto del meta tag)
GA4_ID=
GSC_VERIFICATION=
